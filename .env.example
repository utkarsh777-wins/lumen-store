# SQLite file lives next to the Prisma schema (prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Signs session cookies. Replace this in any shared or production environment.
AUTH_SECRET="dev-only-lumen-secret-change-me"

# Used for canonical URLs, sitemap entries, and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. When both keys are set, checkout uses Stripe test mode.
# Leave blank to use the labeled demo payment instead.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
